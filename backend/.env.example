# Copy to .env and fill in. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://guessings:guessings@localhost:5432/guessings
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
# Shared secret with the Next.js proxy (required when the backend is publicly reachable)
PROXY_SECRET=
# Optional: enables Claude-powered label reading, classification of unknown ingredients and explanations.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Optional: shared rate-limit store for multi-instance deployments
REDIS_URL=
