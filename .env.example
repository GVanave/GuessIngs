# Used by docker-compose.yml. Copy to .env — never commit real values.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=change-me
# Set to false only for plain-HTTP testing on a non-localhost host.
COOKIE_SECURE=true
# Optional: enables Claude-powered label reading, classification of unknown ingredients and explanations.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Optional: enables voice input (POST /api/voice/transcribe). Any OpenAI-compatible speech-to-text endpoint works.
STT_API_KEY=
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_MODEL=whisper-1
